# PostgreSQL Database Connection URL
# Format: postgres://username:password@host:port/database?sslmode=require&options=-csearch_path%3Dschema_name
#
# Local development example (without SSL):
# AIVEN_POSTGRES_URL=postgres://postgres:your_password@localhost:5432/your_database?options=-csearch_path%3Dpublic
#
# Aiven/Cloud example (with SSL):
# AIVEN_POSTGRES_URL=postgres://your_user:your_password@your-host.aivencloud.com:16503/your_db?sslmode=require&options=-csearch_path%3Dslow
#
# Notes:
# - Replace placeholders (your_user, your_password, etc.) with actual values
# - The `options=-csearch_path%3Dslow` parameter sets the default schema to 'slow'
# - For production, set this as a system environment variable instead of using .env file
AIVEN_POSTGRES_URL=postgres://username:password@host:port/database?sslmode=require&options=-csearch_path%3Dschema_name
